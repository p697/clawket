{
  "name": "clawket",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7",
    "wrangler": "^4.131.0"
  },
  "overrides": {
    "@react-native/metro-config": "0.83.10",
    "@xmldom/xmldom": "0.8.15",
    "brace-expansion@<1.1.18": "1.1.18",
    "brace-expansion@>=2 <3": "2.1.4",
    "brace-expansion@>=5 <6": "5.0.9",
    "browserslist": "4.28.9",
    "expo": "~55.0.31",
    "expo-modules-core": "~55.0.26",
    "form-data": "4.0.6",
    "handlebars": "4.7.9",
    "jest-expo": "~55.0.22",
    "js-yaml@<4": "3.15.2",
    "lodash": "4.18.1",
    "metro": "0.83.8",
    "metro-config": "0.83.8",
    "metro-transform-worker": "0.83.8",
    "picomatch@>=2 <3": "2.3.2",
    "picomatch@>=4 <5": "4.0.7",
    "shell-quote": "1.10.0"
  },
  "scripts": {
    "postinstall": "node scripts/setup-mobile-node-modules.mjs && node apps/mobile/scripts/patch-paste-input-podspec.mjs && node apps/mobile/scripts/patch-expo-permissions.mjs && node apps/mobile/scripts/patch-enriched-markdown-tail-fade.mjs",
    "check:docs": "node scripts/check-agent-docs.mjs && node --test scripts/check-agent-docs.test.mjs",
    "check:required": "npm run typecheck && npm run test:required && npm run mobile:check:design-system && npm run --workspace clawket i18n:check && npm run check:docs",
    "typecheck": "npm run protocol:typecheck && npm run mobile:typecheck && npm run relay:typecheck && npm run bridge:typecheck",
    "test": "npm run protocol:test && npm run mobile:test -- --runInBand && npm run relay:test && npm run bridge:test",
    "test:required": "npm run protocol:test:coverage && npm run mobile:test -- --runInBand && npm run relay:test && npm run bridge:test:required && node --test apps/mobile/scripts/jest-paths.test.mjs apps/mobile/scripts/android-release-signing.test.mjs apps/mobile/scripts/check-public-config.test.mjs apps/mobile/scripts/patch-android-native-deps.test.mjs apps/mobile/scripts/patch-paste-input-podspec.test.mjs apps/mobile/scripts/patch-expo-permissions.test.mjs scripts/bridge/publish-cli.test.mjs scripts/bridge/local-model-supervisor.test.mjs scripts/metrics/loc.test.mjs scripts/relay/hermes-device-dev.test.mjs scripts/relay/preview-hermes-smoke.test.mjs scripts/relay/run-wrangler.test.mjs scripts/setup-mobile-node-modules.test.mjs",
    "test:compat": "vitest run --config tests/compat/vitest.config.ts",
    "test:release:compat": "vitest run --config tests/release/vitest.config.ts",
    "metrics:loc": "node scripts/metrics/loc.mjs",
    "build": "npm run bridge:build",
    "mobile:start": "npm run --workspace clawket start",
    "mobile:ios": "npm run --workspace clawket ios",
    "mobile:android": "npm run --workspace clawket android",
    "mobile:sync:native": "npm --prefix apps/mobile install && npm run --workspace clawket prebuild:clean && npm run --workspace clawket pod-install:ios",
    "mobile:dev:ios": "npm run --workspace clawket dev",
    "mobile:dev:android": "npm run --workspace clawket dev:android",
    "mobile:dev:macos": "npm run --workspace clawket dev:macos",
    "mobile:build:macos": "npm run --workspace clawket build:macos",
    "mobile:archive:macos": "npm run --workspace clawket archive:macos",
    "mobile:export:macos": "npm run --workspace clawket export:macos",
    "mobile:build:android:pro-temp": "npm run --workspace clawket build:android:pro-temp",
    "mobile:config:show": "npm run --workspace clawket config:show",
    "mobile:config:check": "npm run --workspace clawket config:check",
    "mobile:config:check:ios": "npm run --workspace clawket config:check:ios",
    "mobile:typecheck": "npm run --workspace clawket typecheck",
    "mobile:check:design-system": "npm run --workspace clawket check:design-system",
    "mobile:test": "npm run --workspace clawket test --",
    "protocol:typecheck": "npm run --workspace @clawket/agent-protocol typecheck",
    "protocol:test": "npm run --workspace @clawket/agent-protocol test",
    "protocol:test:coverage": "npm run --workspace @clawket/agent-protocol test:coverage",
    "relay:typecheck": "npm run --workspace @clawket/shared typecheck && npm run --workspace @clawket/registry-worker typecheck && npm run --workspace @clawket/relay-worker typecheck",
    "relay:test": "npm run --workspace @clawket/shared test && npm run --workspace @clawket/registry-worker test && npm run --workspace @clawket/relay-worker test",
    "relay:test:integration": "vitest run --dir tests/integration",
    "relay:test:preview-product": "npm run --workspace @clawket/bridge-core build && node scripts/relay/preview-product-smoke.mjs",
    "relay:test:preview-hermes": "node scripts/relay/preview-hermes-smoke.mjs",
    "relay:dev:registry": "node scripts/relay/run-wrangler.mjs dev relay-registry",
    "relay:dev:worker": "node scripts/relay/run-wrangler.mjs dev relay-worker",
    "relay:dev:hermes-registry": "node scripts/relay/run-wrangler.mjs dev relay-registry --config-file wrangler.hermes.local.toml",
    "relay:dev:hermes-worker": "node scripts/relay/run-wrangler.mjs dev relay-worker --config-file wrangler.hermes.local.toml",
    "relay:dev:hermes-preview-registry": "node scripts/relay/run-wrangler.mjs dev relay-registry --config-file wrangler.hermes.preview.local.toml",
    "relay:dev:hermes-preview-worker": "node scripts/relay/run-wrangler.mjs dev relay-worker --config-file wrangler.hermes.preview.local.toml",
    "relay:dev:hermes-registry:device": "node scripts/relay/hermes-device-dev.mjs registry",
    "relay:dev:hermes-worker:device": "node scripts/relay/hermes-device-dev.mjs worker",
    "relay:deploy:registry": "node scripts/relay/run-wrangler.mjs deploy relay-registry",
    "relay:deploy:worker": "node scripts/relay/run-wrangler.mjs deploy relay-worker",
    "relay:deploy:preview-registry": "node scripts/relay/run-wrangler.mjs deploy relay-registry --config-file wrangler.preview.local.toml",
    "relay:deploy:preview-worker": "node scripts/relay/run-wrangler.mjs deploy relay-worker --config-file wrangler.preview.local.toml",
    "relay:deploy:hermes-registry": "node scripts/relay/run-wrangler.mjs deploy relay-registry --config-file wrangler.hermes.local.toml",
    "relay:deploy:hermes-worker": "node scripts/relay/run-wrangler.mjs deploy relay-worker --config-file wrangler.hermes.local.toml",
    "relay:deploy:hermes-preview-registry": "node scripts/relay/run-wrangler.mjs deploy relay-registry --config-file wrangler.hermes.preview.local.toml",
    "relay:deploy:hermes-preview-worker": "node scripts/relay/run-wrangler.mjs deploy relay-worker --config-file wrangler.hermes.preview.local.toml",
    "relay:tail:registry": "node scripts/relay/run-wrangler.mjs tail relay-registry",
    "relay:tail:worker": "node scripts/relay/run-wrangler.mjs tail relay-worker",
    "relay:tail:preview-registry": "node scripts/relay/run-wrangler.mjs tail relay-registry --config-file wrangler.preview.local.toml",
    "relay:tail:preview-worker": "node scripts/relay/run-wrangler.mjs tail relay-worker --config-file wrangler.preview.local.toml",
    "relay:tail:hermes-registry": "node scripts/relay/run-wrangler.mjs tail relay-registry --config-file wrangler.hermes.local.toml",
    "relay:tail:hermes-worker": "node scripts/relay/run-wrangler.mjs tail relay-worker --config-file wrangler.hermes.local.toml",
    "relay:tail:hermes-preview-registry": "node scripts/relay/run-wrangler.mjs tail relay-registry --config-file wrangler.hermes.preview.local.toml",
    "relay:tail:hermes-preview-worker": "node scripts/relay/run-wrangler.mjs tail relay-worker --config-file wrangler.hermes.preview.local.toml",
    "relay:cf:login": "wrangler login",
    "relay:cf:whoami": "wrangler whoami",
    "relay:cf:logout": "wrangler logout",
    "bridge:build": "npm run --workspace @clawket/bridge-core build && npm run --workspace @clawket/bridge-runtime build && npm run --workspace @p697/clawket build",
    "bridge:test": "npm run --workspace @clawket/bridge-core test && npm run --workspace @clawket/bridge-runtime test && npm run --workspace @p697/clawket test",
    "bridge:test:required": "npm run --workspace @clawket/bridge-core test && npm run --workspace @clawket/bridge-runtime test:required && npm run --workspace @p697/clawket test",
    "bridge:typecheck": "npm run --workspace @clawket/bridge-core build && npm run --workspace @clawket/bridge-runtime build && npm run --workspace @p697/clawket typecheck",
    "bridge:cli:build": "npm run --workspace @p697/clawket build",
    "bridge:cli:verify-package": "npm run --workspace @p697/clawket verify:package",
    "bridge:cli:publish:dry-run": "npm run --workspace @p697/clawket publish:dry-run",
    "bridge:publish": "node scripts/bridge/publish-cli.mjs",
    "bridge:hermes:dev": "node scripts/bridge/run-hermes-dev.mjs",
    "bridge:hermes:dev:once": "npm run --workspace @p697/clawket hermes:dev --",
    "bridge:pair": "npm run --workspace @p697/clawket pair --",
    "bridge:pair:preview": "npm run --workspace @p697/clawket pair -- --preview",
    "bridge:pair:local": "npm run --workspace @p697/clawket pair -- --local",
    "bridge:pair:hermes": "npm run --workspace @p697/clawket pair -- --backend hermes",
    "bridge:pair:local:hermes": "npm run --workspace @p697/clawket pair -- --local --backend hermes",
    "bridge:pair:relay:hermes": "npm run --workspace @p697/clawket hermes:pair:relay --",
    "bridge:pair:relay:hermes:device": "node scripts/relay/hermes-device-dev.mjs pair",
    "bridge:run:relay:hermes": "npm run --workspace @p697/clawket hermes:relay:run --",
    "bridge:refresh-code": "npm run --workspace @p697/clawket refresh-code --",
    "bridge:install": "npm run --workspace @p697/clawket cmd:install --",
    "bridge:start": "npm run --workspace @p697/clawket start --",
    "bridge:restart": "npm run --workspace @p697/clawket restart --",
    "bridge:stop": "npm run --workspace @p697/clawket stop --",
    "bridge:uninstall": "npm run --workspace @p697/clawket uninstall --",
    "bridge:reset": "npm run --workspace @p697/clawket reset --",
    "bridge:status": "npm run --workspace @p697/clawket status --",
    "bridge:logs": "npm run --workspace @p697/clawket logs --",
    "bridge:doctor": "npm run --workspace @p697/clawket doctor --",
    "bridge:run": "npm run --workspace @p697/clawket run --"
  },
  "enriched-markdown": {
    "enableMath": false
  }
}
