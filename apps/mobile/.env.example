# Public client configuration. These values can be embedded in the app bundle.
# Leave analytics values empty to disable analytics in self-hosted builds.
# Leave RevenueCat values empty to disable subscription billing; official builds require it.
EXPO_PUBLIC_POSTHOG_ENABLED=
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
EXPO_PUBLIC_REVENUECAT_ENABLED=
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=
EXPO_PUBLIC_REVENUECAT_PRO_ENTITLEMENT_ID=
EXPO_PUBLIC_REVENUECAT_PRO_OFFERING_ID=
EXPO_PUBLIC_REVENUECAT_PRO_PACKAGE_ID=
EXPO_PUBLIC_IOS_APP_STORE_ID=
EXPO_PUBLIC_DISCORD_INVITE_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_OF_USE_URL=
EXPO_PUBLIC_DOCS_URL=
EXPO_PUBLIC_OPENCLAW_RELEASES_URL=
EXPO_PUBLIC_OPENCLAW_LATEST_RELEASE_API=
EXPO_PUBLIC_OFFICE_DEV_URL=

# Optional local-only overrides for development or release engineering.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
EXPO_PUBLIC_UNLOCK_PRO=
EXPO_PUBLIC_YOUMIND_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_YOUMIND_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_YOUMIND_GOOGLE_WEB_CLIENT_ID=
# Legacy YouMind client HMAC value: extractable from app bundles, never a server secret.
# Optional; leave empty if not using YouMind. See SECURITY.md before configuring it.
EXPO_PUBLIC_YOUMIND_APP_SECRET=
EXPO_APPLE_TEAM_ID=
EXPO_EAS_OWNER=
EXPO_EAS_PROJECT_ID=
EXPO_ANDROID_VERSION_CODE=

# Official Clawket store builds only: enforce analytics, billing and official speech.
# Leave unset for community/self-hosted builds (including Release/Archive).
CLAWKET_OFFICIAL_BUILD=

# Independent speech service endpoint (wss://.../v1/speech). Never place a provider key here.
EXPO_PUBLIC_SPEECH_URL=
