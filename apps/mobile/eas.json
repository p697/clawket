{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "testflight": {
      "extends": "production",
      "distribution": "store",
      "autoIncrement": true
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "env": {
        "CLAWKET_REQUIRE_SPEECH": "1",
        "EXPO_PUBLIC_SPEECH_URL": "wss://speech.clawket.ai/v1/speech"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "testflight": {},
    "production": {}
  }
}
