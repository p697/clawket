<LinearLayout android:id="@+id/widget_root" xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp" android:background="@drawable/widget_background">
  <LinearLayout android:id="@+id/widget_chat" android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="10dp" android:background="@drawable/widget_secondary" android:contentDescription="@string/widget_chat">
    <ImageView android:id="@+id/widget_mark" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/widget_mark" android:background="@drawable/widget_circle" android:clipToOutline="true" android:importantForAccessibility="no"/>
    <TextView android:id="@+id/widget_prompt" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/widget_chat" android:textSize="18sp" android:textColor="@color/widget_prompt" android:fontFamily="sans" android:maxLines="1" android:ellipsize="end" android:importantForAccessibility="no"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/widget_actions" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center" android:baselineAligned="false">
    <ImageButton android:id="@+id/widget_camera" android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/widget_circle" android:src="@drawable/widget_camera_icon" android:contentDescription="@string/widget_camera" android:scaleType="fitCenter" android:padding="14dp"/>
    <TextView android:importantForAccessibility="no" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
    <ImageButton android:id="@+id/widget_voice" android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/widget_circle" android:src="@drawable/widget_voice_icon" android:contentDescription="@string/widget_voice" android:scaleType="fitCenter" android:padding="14dp"/>
  </LinearLayout>
</LinearLayout>
