{
  "expo": {
    "name": "Clawket",
    "slug": "clawket",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.p697.clawket",
      "associatedDomains": [
        "applinks:registry.clawket.ai",
        "applinks:clawket-registry-preview.clawket.workers.dev"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Clawket to use your camera to scan QR codes and take photos to send to AI.",
        "NSPhotoLibraryAddUsageDescription": "Allow Clawket to save stats posters to your photo library.",
        "NSSpeechRecognitionUsageDescription": "Allow Clawket to transcribe your speech into chat messages.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "en",
          "zh-Hans",
          "zh-Hant",
          "ja",
          "ko",
          "de",
          "fr",
          "es",
          "es-419",
          "it",
          "pt-BR",
          "pt-PT",
          "ru",
          "uk",
          "tr",
          "vi",
          "th",
          "hi",
          "ar"
        ],
        "CFBundleDevelopmentRegion": "en",
        "UIPrefersShowingLanguageSettings": true
      },
      "appleTeamId": "C8TM82D73W",
      "deploymentTarget": "16.4"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.p697.clawket",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "registry.clawket.ai",
              "pathPrefix": "/pair/"
            },
            {
              "scheme": "https",
              "host": "clawket-registry-preview.clawket.workers.dev",
              "pathPrefix": "/pair/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Clawket to access your location so your AI agent can know where you are."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Clawket to show your recent photos when attaching images and to save stats posters to your photo library.",
          "savePhotosPermission": "Allow Clawket to save stats posters to your photo library."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 5,
              "supportsImageWithMaxCount": 5,
              "supportsFileWithMaxCount": 3
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/*",
              "image/*",
              "application/*"
            ],
            "multipleShareMimeTypes": [
              "image/*"
            ]
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": [
            "en",
            "zh-Hans",
            "zh-Hant",
            "ja",
            "ko",
            "de",
            "fr",
            "es",
            "es-419",
            "it",
            "pt-BR",
            "pt-PT",
            "ru",
            "uk",
            "tr",
            "vi",
            "th",
            "hi",
            "ar"
          ]
        }
      ],
      "./plugins/with-locales",
      "./plugins/with-alternate-app-icons",
      "./plugins/with-android-release-signing",
      "./plugins/with-paste-input-setup",
      "./plugins/with-xcode-env",
      "./plugins/with-ios-pod-deployment-target",
      "./plugins/with-ios-signing",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true,
            "usePrecompiledModules": false
          }
        }
      ]
    ],
    "scheme": "clawket",
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "expo-sharing-extension",
                  "bundleIdentifier": "com.p697.clawket.expo-sharing-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.p697.clawket"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "972e845f-da81-44db-a908-24be4ca80288"
      }
    },
    "owner": "p697"
  }
}
