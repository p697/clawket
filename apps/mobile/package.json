{
  "name": "clawket",
  "version": "3.0.0",
  "license": "AGPL-3.0-only",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "postinstall": "node ./scripts/patch-android-native-deps.mjs && node ./scripts/patch-paste-input-podspec.mjs && node ./scripts/patch-expo-permissions.mjs && node ./scripts/patch-enriched-markdown-tail-fade.mjs",
    "eas-build-pre-install": "./scripts/eas-validate-public-config.sh",
    "eas:env:sync": "node scripts/sync-eas-env-from-local.mjs",
    "prebuild:clean": "npx expo prebuild --clean",
    "pod-install:ios": "npx pod-install ios",
    "dev": "./scripts/dev-ios.sh",
    "dev:android": "node ./scripts/dev-android.mjs",
    "dev:macos": "./scripts/dev-macos.sh",
    "build:macos": "./scripts/build-macos.sh",
    "archive:macos": "./scripts/archive-macos.sh",
    "export:macos": "./scripts/export-macos.sh",
    "build:android:aab": "./scripts/build-android-aab.sh",
    "build:android:apk": "./scripts/build-android-apk.sh",
    "build:android:pro-temp": "./scripts/build-android-pro-temp.sh",
    "web": "expo start --web",
    "config:show": "node scripts/check-public-config.mjs --json",
    "config:check": "node scripts/check-public-config.mjs",
    "config:check:android": "node scripts/check-public-config.mjs --platform=android",
    "config:check:ios": "node scripts/check-public-config.mjs --platform=ios",
    "android:signing:restore": "./scripts/restore-android-signing.sh",
    "android:signing:test": "node --test scripts/android-release-signing.test.mjs",
    "android:native-deps:patch": "node ./scripts/patch-android-native-deps.mjs",
    "paste-input:patch": "node ./scripts/patch-paste-input-podspec.mjs",
    "typecheck": "tsc --noEmit",
    "check:ui-style": "node scripts/check-ui-style.mjs",
    "check:ui-style:selftest": "node scripts/check-ui-style.selftest.mjs",
    "check:app-config": "node scripts/check-app-config.mjs && node --test scripts/check-app-config.test.mjs",
    "check:design-system:docs": "node scripts/check-design-system-docs.mjs && node --test scripts/check-design-system-docs.selftest.mjs",
    "check:design-system": "npm run check:ui-style && npm run check:ui-style:selftest && npm run check:app-config && npm run check:design-system:docs",
    "i18n:check": "node scripts/i18n-prune.mjs --strict && node --test scripts/i18n-prune.selftest.mjs",
    "i18n:prune:report": "node scripts/i18n-prune.mjs",
    "i18n:prune:strict": "node scripts/i18n-prune.mjs --strict",
    "i18n:prune:write": "node scripts/i18n-prune.mjs --write",
    "i18n:prune:selftest": "node --test scripts/i18n-prune.selftest.mjs",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "build:android:preview": "node ./scripts/build-android-preview.mjs"
  },
  "dependencies": {
    "@clawket/agent-protocol": "file:../../packages/agent-protocol",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@likashefqet/react-native-image-zoom": "^4.3.0",
    "@mattermost/react-native-paste-input": "^2.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-menu/menu": "^2.0.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.13.0",
    "@shopify/flash-list": "^2.3.0",
    "croner": "10.0.1",
    "expo": "~57.0.23",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.17",
    "expo-battery": "~57.0.3",
    "expo-build-properties": "~57.0.20",
    "expo-camera": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.18",
    "expo-image-picker": "~57.0.18",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.18",
    "expo-media-library": "~57.0.5",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.19",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.20",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "i18next": "^25.8.14",
    "js-sha256": "^0.11.1",
    "lucide-react-native": "^0.575.0",
    "posthog-react-native": "^4.37.1",
    "react": "19.2.3",
    "react-i18next": "^16.5.6",
    "react-native": "0.86.3",
    "react-native-enriched-markdown": "1.0.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-purchases": "^9.11.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.1",
    "remend": "^1.2.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~57.0.12",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "sharp": "^0.35.4",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "brace-expansion@<1.1.18": "1.1.18",
    "brace-expansion@>=2 <3": "2.1.4",
    "brace-expansion@>=5 <6": "5.0.9",
    "browserslist": "4.28.9",
    "form-data": "4.0.6",
    "js-yaml@<4": "3.15.2",
    "lodash": "4.18.1",
    "shell-quote": "1.10.0",
    "ws@>=7 <8": "7.5.11",
    "ws@>=8 <9": "8.21.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@shopify/flash-list",
        "@types/jest"
      ]
    }
  },
  "private": true,
  "enriched-markdown": {
    "enableMath": false
  }
}
