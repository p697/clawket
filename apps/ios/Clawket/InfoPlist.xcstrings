{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "comment": "System permission purpose. Explain this real capability; do not promise broader access or translate Agent names.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan a pairing QR code to connect your agent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描配对二维码，连接你的 Agent。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描配對 QR 碼，連線你的 Agent。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング用QRコードをスキャンして、エージェントに接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링 QR 코드를 스캔하여 에이전트에 연결합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne einen Kopplungs-QR-Code, um deinen Agenten zu verbinden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanner un code QR de jumelage pour connecter votre Agent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanear un código QR de emparejamiento para conectar tu Agente."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanear un código QR de emparejamiento para conectar tu Agente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona un codice QR di abbinamento per collegare il tuo Agent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ler um código QR de pareamento para conectar seu Agent."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ler um código QR de emparelhamento para ligar o seu Agent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканировать QR-код сопряжения, чтобы подключить агента."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканувати QR-код з’єднання для підключення агента."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent’ınıza bağlanmak için eşleştirme QR kodunu tarayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét mã QR ghép nối để kết nối Agent của bạn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกน QR จับคู่เพื่อเชื่อมต่อ Agent ของคุณ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Agent से कनेक्ट करने के लिए पेयरिंग QR कोड स्कैन करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسح رمز QR للاقتران والاتصال بوكيلك."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "comment": "System permission purpose. Explain this real capability; do not promise broader access or translate Agent names.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to agents running on your local network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接你本地网络中运行的 Agent。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線你區域網路中執行的 Agent。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワークで稼働中のエージェントに接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 네트워크에서 실행 중인 에이전트에 연결합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde dich mit Agenten, die in deinem lokalen Netzwerk laufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecter aux Agents qui fonctionnent sur votre réseau local."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar con Agentes que se ejecutan en tu red local."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar con Agentes que se ejecutan en tu red local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega gli Agent in esecuzione sulla tua rete locale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar aos Agents em execução na sua rede local."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligar aos Agents em execução na sua rede local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключаться к агентам, работающим в вашей локальной сети."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключатися до агентів, що працюють у вашій локальній мережі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel ağınızda çalışan Agent’lara bağlanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối tới các Agent đang chạy trên mạng cục bộ của bạn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อ Agent ที่ทำงานอยู่ในเครือข่ายภายในของคุณ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने लोकल नेटवर्क पर चल रहे Agent से कनेक्ट करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاتصال بالوكلاء العاملين على شبكتك المحلية."
          }
        }
      }
    }
  },
  "version": "1.0"
}
