    "Complete redemption in the store. Your Pro access will sync here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكمل استرداد الرمز في المتجر. ستتم مزامنة وصولك إلى Pro هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löse den Code im Store ein. Dein Pro-Zugang wird hier synchronisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete redemption in the store. Your Pro access will sync here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Canjea el código en la tienda. Tu acceso Pro se sincronizará aquí."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Canjea el código en la tienda. Tu acceso Pro se sincronizará aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le code dans la boutique. Votre accès Pro sera synchronisé ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टोर में कोड रिडीम करें। आपका Pro ऐक्सेस यहाँ सिंक हो जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riscatta il codice nello store. Il tuo accesso Pro verrà sincronizzato qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストアでコードを利用してください。Pro の利用権がここに同期されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스토어에서 코드를 사용하세요. Pro 이용 권한이 여기에 동기화됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resgate o código na loja. Seu acesso Pro será sincronizado aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Resgata o código na loja. O teu acesso Pro será sincronizado aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активируйте код в магазине. Доступ Pro синхронизируется здесь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แลกรหัสในสโตร์ให้เสร็จ สิทธิ์ Pro ของคุณจะซิงค์มาที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodu mağazada kullan. Pro erişimin burada eşitlenecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Активуйте код у магазині. Доступ Pro синхронізується тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoàn tất đổi mã trong cửa hàng. Quyền truy cập Pro sẽ được đồng bộ tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在商店完成兑换，Pro 权益会同步到这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在商店完成兌換，Pro 權益會同步到這裡。"
          }
        }
      },
      "extractionState": "manual"
    },
