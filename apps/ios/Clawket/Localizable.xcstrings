          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia o código QR apresentado pelo Clawket no computador ou cole a ligação de emparelhamento."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터의 Clawket에 표시된 QR 코드를 스캔하거나 페어링 링크를 붙여넣으세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте QR-код, показанный Clawket на компьютере, или вставьте ссылку сопряжения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відскануйте QR-код, який Clawket показує на комп’ютері, або вставте посилання з’єднання."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarınızdaki Clawket’te gösterilen QR kodunu tarayın veya eşleştirme bağlantısını yapıştırın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
