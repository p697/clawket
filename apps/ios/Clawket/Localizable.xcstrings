    "Open OpenClaw on your computer and approve the device whose ID matches this one.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open OpenClaw on your computer and approve the device whose ID matches this one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在电脑上打开 OpenClaw，批准设备 ID 与此处一致的设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在電腦上開啟 OpenClaw，批准裝置 ID 與此處一致的裝置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータでOpenClawを開き、ここに表示されているIDと一致するデバイスを承認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터에서 OpenClaw를 열고 여기에 표시된 ID와 일치하는 기기를 승인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne OpenClaw auf deinem Computer und gib das Gerät frei, dessen ID mit dieser übereinstimmt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez OpenClaw sur votre ordinateur et approuvez l’appareil dont l’identifiant correspond à celui-ci."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre OpenClaw en tu ordenador y aprueba el dispositivo cuyo ID coincida con este."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre OpenClaw en tu computadora y aprueba el dispositivo cuyo ID coincida con este."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri OpenClaw sul computer e approva il dispositivo il cui ID corrisponde a questo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o OpenClaw no computador e aprove o dispositivo cujo ID corresponda a este."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o OpenClaw no computador e aprove o dispositivo cujo ID corresponda a este."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте OpenClaw на компьютере и одобрите устройство, чей ID совпадает с этим."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте OpenClaw на комп’ютері й схваліть пристрій, ID якого збігається із цим."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarınızda OpenClaw’ı açın ve kimliği buradakiyle eşleşen cihazı onaylayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở OpenClaw trên máy tính và phê duyệt thiết bị có ID trùng với ID này."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด OpenClaw บนคอมพิวเตอร์ แล้วอนุมัติอุปกรณ์ที่มี ID ตรงกับที่แสดงนี้"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने कंप्यूटर पर OpenClaw खोलें और उस डिवाइस को मंज़ूरी दें जिसका ID इससे मेल खाता है।"
          }
        },
        "ar": {
