    "Lifetime does not cancel your existing subscription. Turn off its renewal in your store to avoid further charges.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شراء الوصول مدى الحياة لا يلغي اشتراكك الحالي. أوقف تجديده في متجرك لتجنب رسوم إضافية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dauerlizenz kündigt dein bestehendes Abonnement nicht. Deaktiviere dessen Verlängerung im Store, um weitere Abbuchungen zu vermeiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lifetime does not cancel your existing subscription. Turn off its renewal in your store to avoid further charges."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso de por vida no cancela tu suscripción actual. Desactiva su renovación en tu tienda para evitar más cobros."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso de por vida no cancela tu suscripción actual. Desactiva su renovación en tu tienda para evitar más cobros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à vie n’annule pas votre abonnement actuel. Désactivez son renouvellement dans votre boutique pour éviter de nouveaux prélèvements."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आजीवन एक्सेस खरीदने से मौजूदा सदस्यता रद्द नहीं होती। आगे शुल्क से बचने के लिए स्टोर में उसका नवीनीकरण बंद करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso a vita non annulla l’abbonamento esistente. Disattiva il rinnovo nel tuo store per evitare ulteriori addebiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "買い切り版を購入しても現在のサブスクリプションは解約されません。追加の請求を避けるため、ストアで自動更新を停止してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평생 이용권을 구매해도 기존 구독은 취소되지 않습니다. 추가 요금이 청구되지 않도록 스토어에서 기존 구독의 자동 갱신을 끄세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso vitalício não cancela sua assinatura atual. Desative a renovação na sua loja para evitar novas cobranças."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso vitalício não cancela a subscrição atual. Desative a renovação na sua loja para evitar novas cobranças."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бессрочный доступ не отменяет текущую подписку. Отключите её продление в магазине, чтобы избежать дальнейших списаний."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การซื้อสิทธิ์ตลอดชีพจะไม่ยกเลิกการสมัครสมาชิกเดิม โปรดปิดการต่ออายุในร้านค้าเพื่อหลีกเลี่ยงการเรียกเก็บเงินเพิ่มเติม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ömür boyu erişim mevcut aboneliğinizi iptal etmez. Yeni ücretlerden kaçınmak için mağazanızda yenilemeyi kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безстроковий доступ не скасовує поточну підписку. Вимкніть її поновлення в магазині, щоб уникнути подальших списань."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mua quyền truy cập trọn đời không hủy đăng ký hiện tại. Hãy tắt gia hạn trong cửa hàng để tránh bị tính phí tiếp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
