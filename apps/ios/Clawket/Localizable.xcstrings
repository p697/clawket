          }
        }
      },
      "comment": "Native UI / accessibility."
    },
    "This invitation has expired or was already used. Get a new code from your computer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This invitation has expired or was already used. Get a new code from your computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此邀请已过期或已使用。请从电脑获取新的配对码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此邀請已過期或已使用。請從電腦取得新的配對碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この招待は期限切れか使用済みです。コンピュータで新しいコードを取得してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einladung ist abgelaufen oder wurde bereits verwendet. Hole dir einen neuen Code auf deinem Computer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette invitation a expiré ou a déjà été utilisée. Obtenez un nouveau code sur votre ordinateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo invito è scaduto o è già stato usato. Ottieni un nuovo codice dal computer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta invitación ha caducado o ya se ha usado. Obtén un código nuevo en tu ordenador."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta invitación venció o ya se usó. Obtén un código nuevo en tu computadora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este convite expirou ou já foi usado. Obtenha um novo código no computador."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este convite expirou ou já foi utilizado. Obtenha um novo código no computador."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 초대가 만료되었거나 이미 사용되었습니다. 컴퓨터에서 새 코드를 받으세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок приглашения истёк или оно уже использовано. Получите новый код на компьютере."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термін дії запрошення минув або його вже використано. Отримайте новий код на комп’ютері."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu davetin süresi dolmuş veya davet kullanılmış. Bilgisayarınızdan yeni bir kod alın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời mời này đã hết hạn hoặc đã được dùng. Lấy mã mới trên máy tính."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำเชิญนี้หมดอายุหรือถูกใช้แล้ว รับรหัสใหม่จากคอมพิวเตอร์ของคุณ"
          }
        },
        "hi": {
