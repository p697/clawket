          "stringUnit": {
            "state": "translated",
            "value": "Đang chờ bạn xác nhận. Gửi tin nhắn này khi có kết nối."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รอการยืนยันจากคุณ ส่งข้อความนี้เมื่อเชื่อมต่อได้"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी पुष्टि का इंतज़ार है। कनेक्शन उपलब्ध होने पर यह संदेश भेजें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بانتظار تأكيدك. أرسل هذه الرسالة عندما يصبح الاتصال متاحًا."
          }
        }
      },
      "comment": "Native UI / accessibility."
    },
    "Reconnect or refresh conversations before creating another.": {
