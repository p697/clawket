    "Delete this conversation from the connected agent? This cannot be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this conversation from the connected agent? This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要从已连接的 Agent 删除此会话吗？此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要從已連線的 Agent 刪除此對話嗎？此操作無法復原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続中のエージェントからこの会話を削除しますか？この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 에이전트에서 이 대화를 삭제할까요? 이 작업은 되돌릴 수 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Unterhaltung beim verbundenen Agenten löschen? Dies kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer cette conversation de l’agent connecté ? Cette action est irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar esta conversación del agente conectado? Esta acción no se puede deshacer."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar esta conversación del agente conectado? Esta acción no se puede deshacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare questa conversazione dall’agente connesso? Questa operazione non può essere annullata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir esta conversa do agente conectado? Esta ação não pode ser desfeita."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar esta conversa do agente ligado? Esta ação não pode ser anulada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить этот чат у подключённого агента? Это действие нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити цей чат у підключеного агента? Цю дію неможливо скасувати."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sohbet bağlı ajandan silinsin mi? Bu işlem geri alınamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa cuộc trò chuyện này khỏi Agent đang kết nối? Bạn không thể hoàn tác thao tác này."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบการสนทนานี้จาก Agent ที่เชื่อมต่ออยู่หรือไม่ การดำเนินการนี้เลิกทำไม่ได้"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या कनेक्ट किए गए एजेंट से यह बातचीत मिटानी है? यह कार्रवाई वापस नहीं ली जा सकती।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف هذه المحادثة من الوكيل المتصل؟ لا يمكن التراجع عن هذا الإجراء."
          }
        }
      },
      "extractionState": "manual"
    },
