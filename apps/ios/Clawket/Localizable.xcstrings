          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre audio est sauvegardé sur cet appareil. Réessayez la transcription ou supprimez-le."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu audio está guardado en este dispositivo. Reintenta la transcripción o elimínalo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu audio está guardado en este dispositivo. Reintenta la transcripción o elimínalo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio è salvato su questo dispositivo. Riprova la trascrizione o eliminalo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu áudio está salvo neste dispositivo. Tente transcrever novamente ou exclua-o."
