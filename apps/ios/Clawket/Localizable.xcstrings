    "Could not complete pairing. Check the details and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not complete pairing. Check the details and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成配对。请检查信息后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完成配對。請檢查資訊後再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングを完了できませんでした。入力内容を確認して、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopplung konnte nicht abgeschlossen werden. Prüfe die Angaben und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jumelage n’a pas pu être effectué. Vérifiez les informations et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile completare l’abbinamento. Controlla i dettagli e riprova."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido completar el emparejamiento. Comprueba los datos e inténtalo de nuevo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar el emparejamiento. Revisa los datos e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir o pareamento. Confira os dados e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir o emparelhamento. Verifique os dados e tente novamente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링을 완료하지 못했습니다. 입력 내용을 확인한 후 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось завершить сопряжение. Проверьте данные и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завершити з’єднання. Перевірте дані й спробуйте ще раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleştirme tamamlanamadı. Bilgileri kontrol edip yeniden deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể hoàn tất ghép nối. Kiểm tra thông tin rồi thử lại."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จับคู่ไม่สำเร็จ ตรวจสอบข้อมูลแล้วลองอีกครั้ง"
