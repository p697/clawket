    "Could not use this pairing code or link. Check it or generate a new invitation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not use this pairing code or link. Check it or generate a new invitation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用此配对码或链接。请检查内容，或生成新的邀请。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用此配對碼或連結。請檢查內容，或產生新的邀請。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このペアリングコードまたはリンクを使用できませんでした。内容を確認するか、新しい招待を作成してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kopplungscode oder Link konnte nicht verwendet werden. Prüfe ihn oder erstelle eine neue Einladung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code ou lien de jumelage n’a pas pu être utilisé. Vérifiez-le ou générez une nouvelle invitation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile usare questo codice o link di abbinamento. Controllalo o genera un nuovo invito."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido usar este código o enlace de emparejamiento. Revísalo o genera una nueva invitación."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo usar este código o enlace de emparejamiento. Revísalo o genera una nueva invitación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível usar este código ou link de pareamento. Verifique-o ou gere um novo convite."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível usar este código ou ligação de emparelhamento. Verifique-o ou gere um novo convite."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 페어링 코드나 링크를 사용할 수 없습니다. 내용을 확인하거나 새 초대를 생성하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось использовать этот код или ссылку сопряжения. Проверьте их или создайте новое приглашение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося скористатися цим кодом або посиланням з’єднання. Перевірте їх або створіть нове запрошення."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu eşleştirme kodu veya bağlantısı kullanılamadı. Kontrol edin veya yeni bir davet oluşturun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể dùng mã hoặc liên kết ghép nối này. Kiểm tra lại hoặc tạo lời mời mới."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้รหัสหรือลิงก์จับคู่นี้ไม่ได้ ตรวจสอบอีกครั้งหรือสร้างคำเชิญใหม่"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पेयरिंग कोड या लिंक इस्तेमाल नहीं हो सका। इसे जाँचें या नया आमंत्रण बनाएँ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر استخدام رمز الاقتران أو رابطه. تحقّق منه أو أنشئ دعوة جديدة."
          }
        }
      },
      "comment": "Native UI / accessibility."
    },
