    "You can paste the QR text or enter the pairing code instead. Check camera access in Settings if needed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can paste the QR text or enter the pairing code instead. Check camera access in Settings if needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以粘贴二维码内容或输入配对码。需要时，请在系统设置中检查相机权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以貼上 QR 碼內容或輸入配對碼。需要時，請在系統設定中檢查相機權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードの内容を貼り付けるか、ペアリングコードを入力できます。必要に応じて「設定」でカメラへのアクセスを確認してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst stattdessen den QR-Text einfügen oder den Kopplungscode eingeben. Prüfe bei Bedarf den Kamerazugriff in den Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez coller le contenu du code QR ou saisir le code de jumelage. Si nécessaire, vérifiez l’accès à l’appareil photo dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi incollare il contenuto del codice QR o inserire il codice di abbinamento. Se necessario, verifica l’accesso alla fotocamera in Impostazioni."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes pegar el contenido del código QR o introducir el código de emparejamiento. Si es necesario, comprueba el acceso a la cámara en Ajustes."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes pegar el contenido del código QR o ingresar el código de emparejamiento. Si hace falta, revisa el acceso a la cámara en Configuración."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode colar o conteúdo do código QR ou digitar o código de pareamento. Se necessário, verifique o acesso à câmera em Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode colar o conteúdo do código QR ou introduzir o código de emparelhamento. Se necessário, verifique o acesso à câmara nas Definições."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "QR 코드 내용을 붙여넣거나 페어링 코드를 입력할 수 있습니다. 필요한 경우 설정에서 카메라 접근 권한을 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно вставить содержимое QR-кода или ввести код сопряжения. При необходимости проверьте доступ к камере в Настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна вставити вміст QR-коду або ввести код з’єднання. За потреби перевірте доступ до камери в Налаштуваннях."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunun yerine QR içeriğini yapıştırabilir veya eşleştirme kodunu girebilirsiniz. Gerekirse Ayarlar’dan kamera erişimini kontrol edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể dán nội dung mã QR hoặc nhập mã ghép nối. Nếu cần, hãy kiểm tra quyền truy cập camera trong Cài đặt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถวางเนื้อหา QR หรือป้อนรหัสจับคู่แทนได้ หากจำเป็น ให้ตรวจสอบสิทธิ์การใช้กล้องในการตั้งค่า"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके बजाय QR का टेक्स्ट पेस्ट करें या पेयरिंग कोड डालें। ज़रूरत हो तो सेटिंग में कैमरे की अनुमति जाँचें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك لصق محتوى رمز QR أو إدخال رمز الاقتران بدلًا من ذلك. تحقّق من إذن الكاميرا في الإعدادات عند الحاجة."
          }
        }
      },
      "comment": "Native UI / accessibility."
    },
    "Your agent could not be reached. Your draft is saved.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your agent could not be reached. Your draft is saved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到你的 Agent。草稿已保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到你的 Agent。草稿已儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントに接続できませんでした。下書きは保存されています。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Agent konnte nicht erreicht werden. Dein Entwurf ist gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Agent est injoignable. Votre brouillon est enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere il tuo Agent. La bozza è salvata."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido contactar con tu Agente. Tu borrador está guardado."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo contactar con tu Agente. Tu borrador está guardado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar seu Agent. Seu rascunho está salvo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível contactar o seu Agent. O seu rascunho está guardado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트에 연결할 수 없습니다. 초안은 저장되었습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с агентом. Черновик сохранён."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зв’язатися з агентом. Чернетку збережено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent’ınıza ulaşılamadı. Taslağınız kaydedildi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kết nối tới Agent. Bản nháp của bạn đã được lưu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถติดต่อ Agent ได้ บันทึกฉบับร่างของคุณแล้ว"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके Agent से कनेक्ट नहीं हो सका। आपका ड्राफ़्ट सेव है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى وكيلك. مسودتك محفوظة."
          }
        }
      },
      "comment": "Native UI / accessibility."
    },
    "Your agent needs to be paired again. Add its current pairing code in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your agent needs to be paired again. Add its current pairing code in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Agent 需要重新配对。请在设置中添加它当前的配对码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Agent 需要重新配對。請在設定中加入它目前的配對碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの再ペアリングが必要です。「設定」で現在のペアリングコードを追加してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Agent muss erneut gekoppelt werden. Füge seinen aktuellen Kopplungscode in den Einstellungen hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Agent doit être jumelé à nouveau. Ajoutez son code de jumelage actuel dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo Agent deve essere abbinato di nuovo. Aggiungi il suo codice di abbinamento attuale in Impostazioni."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes volver a emparejar tu Agente. Añade su código de emparejamiento actual en Ajustes."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes volver a emparejar tu Agente. Agrega su código de emparejamiento actual en Configuración."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu Agent precisa ser pareado novamente. Adicione o código de pareamento atual dele em Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessário voltar a emparelhar o seu Agent. Adicione o código de emparelhamento atual nas Definições."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트를 다시 페어링해야 합니다. 설정에서 현재 페어링 코드를 추가하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необходимо повторно выполнить сопряжение с агентом. Добавьте его текущий код сопряжения в Настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібно знову з’єднати агента. Додайте його поточний код з’єднання в Налаштуваннях."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent’ınızın yeniden eşleştirilmesi gerekiyor. Güncel eşleştirme kodunu Ayarlar’dan ekleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent của bạn cần được ghép nối lại. Thêm mã ghép nối hiện tại trong Cài đặt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent ของคุณต้องจับคู่ใหม่ เพิ่มรหัสจับคู่ปัจจุบันในการตั้งค่า"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके Agent को फिर से पेयर करना होगा। सेटिंग में उसका मौजूदा पेयरिंग कोड जोड़ें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج وكيلك إلى الاقتران مجددًا. أضف رمز الاقتران الحالي في الإعدادات."
          }
        }
      },
      "comment": "Native UI / accessibility."
    },
    "Your agents, within reach": {
