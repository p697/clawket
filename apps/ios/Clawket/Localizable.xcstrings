    "Conversation actions could not be loaded. Close this sheet and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversation actions could not be loaded. Close this sheet and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载会话操作。请关闭此面板后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入對話操作。請關閉此面板後再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話の操作を読み込めませんでした。この画面を閉じてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화 작업을 불러오지 못했습니다. 이 창을 닫고 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktionen für diese Unterhaltung konnten nicht geladen werden. Schließe dieses Fenster und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les actions de cette conversation. Fermez ce panneau et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido cargar las acciones de la conversación. Cierra este panel e inténtalo de nuevo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar las acciones de la conversación. Cierra este panel e inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare le azioni della conversazione. Chiudi questo pannello e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar as ações da conversa. Feche este painel e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar as ações da conversa. Feche este painel e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить действия для чата. Закройте эту панель и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити дії для чату. Закрийте цю панель і спробуйте ще раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet işlemleri yüklenemedi. Bu paneli kapatıp tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tải các thao tác với cuộc trò chuyện. Hãy đóng bảng này rồi thử lại."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดการดำเนินการของการสนทนาไม่ได้ โปรดปิดแผงนี้แล้วลองอีกครั้ง"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बातचीत की कार्रवाइयाँ लोड नहीं हो सकीं। यह पैनल बंद करके फिर कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل إجراءات المحادثة. أغلق هذه اللوحة ثم حاول مجددًا."
          }
        }
      },
      "extractionState": "manual"
    },
    "Conversation details changed. Close this sheet and review them again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversation details changed. Close this sheet and review them again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
