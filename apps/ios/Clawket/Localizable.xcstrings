    "Work in the project. Ask before broader access.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work in the project. Ask before broader access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在项目中工作，更广泛的访问需询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在專案中工作，更廣泛的存取需詢問。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクト内で作業し、それ以外へのアクセスは確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트에서 작업하며, 범위를 벗어난 접근은 확인합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeitet im Projekt. Fragt vor weitergehendem Zugriff."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Travaille dans le projet. Demande pour un accès plus large."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabaja en el proyecto. Pregunta antes de acceder fuera de él."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabaja en el proyecto. Pregunta antes de acceder fuera de él."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavora nel progetto. Chiede prima di accedere altrove."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabalha no projeto. Pede permissão para acessar além dele."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabalha no projeto. Pede permissão para aceder além dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работа в проекте. Более широкий доступ — с разрешения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Робота в проєкті. Ширший доступ — з дозволу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Projede çalışır. Daha geniş erişim için izin ister."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm việc trong dự án. Hỏi trước khi truy cập phạm vi rộng hơn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำงานในโปรเจกต์ ขออนุญาตก่อนเข้าถึงส่วนอื่น"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोजेक्ट में काम करें। अधिक पहुँच से पहले पूछें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل داخل المشروع ويطلب الإذن للوصول الأوسع."
          }
        }
      },
      "comment": "Native model settings. Terminology reused from Mobile chat.Work in the project. Ask before broader access.."
    },
