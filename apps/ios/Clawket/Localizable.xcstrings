            "state": "translated",
            "value": "Se necesita acceso al micrófono para transcribir la voz."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita acceso al micrófono para transcribir la voz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per trascrivere la voce è necessario l’accesso al microfono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessário acesso ao microfone para transcrever a fala."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessário acesso ao microfone para transcrever a fala."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для расшифровки речи нужен доступ к микрофону."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для розшифрування мовлення потрібен доступ до мікрофона."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşmayı yazıya dökmek için mikrofon erişimi gerekiyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần quyền truy cập micrô để chuyển giọng nói thành văn bản."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องได้รับสิทธิ์เข้าถึงไมโครโฟนเพื่อถอดเสียงพูด"
          }
        },
        "hi": {
