    "Your audio is saved on this device. Retry transcription or delete it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your audio is saved on this device. Retry transcription or delete it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频已保存在这台设备上，你可以重新转录或删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊已儲存在此裝置上，你可以重新轉錄或刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声はこの端末に保存されています。文字起こしを再試行するか削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오가 이 기기에 저장되어 있습니다. 변환을 다시 시도하거나 삭제할 수 있습니다."
          }
        },
        "de": {
