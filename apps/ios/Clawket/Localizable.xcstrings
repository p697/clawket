    "Permissions could not be prepared. Refresh settings and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissions could not be prepared. Refresh settings and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法准备权限确认。请刷新设置后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法準備權限確認。請重新整理設定後再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限の確認を準備できませんでした。設定を更新してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한 확인을 준비하지 못했습니다. 설정을 새로 고친 후 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bestätigung der Berechtigungen konnte nicht vorbereitet werden. Aktualisiere die Einstellungen und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de préparer la confirmation des autorisations. Actualisez les paramètres, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido preparar los permisos. Actualiza los ajustes e inténtalo de nuevo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron preparar los permisos. Actualiza la configuración e inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile preparare la conferma delle autorizzazioni. Aggiorna le impostazioni e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível preparar as permissões. Atualize as configurações e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível preparar as permissões. Atualize as definições e tente novamente."
