    "Review this device’s requested access in OpenClaw before approving.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review this device’s requested access in OpenClaw before approving."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准前，请在 OpenClaw 中检查此设备请求的访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "批准前，請在 OpenClaw 中檢查此裝置要求的存取權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認する前に、OpenClawでこのデバイスが要求するアクセス権を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인하기 전에 OpenClaw에서 이 기기가 요청한 접근 권한을 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe vor der Freigabe in OpenClaw die von diesem Gerät angeforderten Zugriffsrechte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant d’approuver, vérifiez dans OpenClaw les accès demandés par cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de aprobarlo, revisa en OpenClaw el acceso que solicita este dispositivo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de aprobarlo, revisa en OpenClaw el acceso que solicita este dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di approvare, verifica in OpenClaw gli accessi richiesti da questo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de aprovar, confira no OpenClaw os acessos solicitados por este dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de aprovar, verifique no OpenClaw os acessos pedidos por este dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед одобрением проверьте в OpenClaw, какие права доступа запрашивает это устройство."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед схваленням перевірте в OpenClaw, які права доступу запитує цей пристрій."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylamadan önce bu cihazın istediği erişimi OpenClaw’da gözden geçirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước khi phê duyệt, hãy kiểm tra quyền truy cập mà thiết bị này yêu cầu trong OpenClaw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบสิทธิ์การเข้าถึงที่อุปกรณ์นี้ร้องขอใน OpenClaw ก่อนอนุมัติ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मंज़ूरी देने से पहले OpenClaw में इस डिवाइस के अनुरोधित ऐक्सेस की समीक्षा करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع صلاحيات الوصول التي يطلبها هذا الجهاز في OpenClaw قبل اعتماده."
          }
        }
      }
    },
