          "stringUnit": {
            "state": "translated",
            "value": "Après avoir approuvé l’appareil, vérifiez à nouveau la connexion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de aprobar el dispositivo, vuelve a comprobar la conexión."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de aprobar el dispositivo, vuelve a verificar la conexión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver approvato il dispositivo, verifica di nuovo la connessione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
