    "Delivery could not be confirmed. Check the conversation before sending again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivery could not be confirmed. Check the conversation before sending again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认消息是否送达。再次发送前，请先查看会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認訊息是否送達。再次傳送前，請先查看對話。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信を確認できませんでした。再送する前にチャットを確認してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zustellung konnte nicht bestätigt werden. Prüfe den Chat, bevor du erneut sendest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
