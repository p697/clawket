    "Change confirmed. Refresh conversations to see the latest state.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change confirmed. Refresh conversations to see the latest state."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改已确认。刷新会话以查看最新状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已確認變更。請重新整理對話以查看最新狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を確認しました。会話を更新して最新の状態を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경이 확인되었습니다. 대화 목록을 새로 고쳐 최신 상태를 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderung bestätigt. Aktualisiere die Unterhaltungen, um den neuesten Stand zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modification confirmée. Actualisez les conversations pour voir leur état actuel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambio confirmado. Actualiza las conversaciones para ver su estado más reciente."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambio confirmado. Actualiza las conversaciones para ver su estado más reciente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica confermata. Aggiorna le conversazioni per vedere lo stato più recente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alteração confirmada. Atualize as conversas para ver o estado mais recente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alteração confirmada. Atualize as conversas para ver o estado mais recente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение подтверждено. Обновите список чатов, чтобы увидеть текущее состояние."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміну підтверджено. Оновіть список чатів, щоб побачити поточний стан."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklik onaylandı. Son durumu görmek için sohbetleri yenileyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xác nhận thay đổi. Hãy làm mới cuộc trò chuyện để xem trạng thái mới nhất."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนยันการเปลี่ยนแปลงแล้ว รีเฟรชการสนทนาเพื่อดูสถานะล่าสุด"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बदलाव की पुष्टि हो गई है। नवीनतम स्थिति देखने के लिए बातचीत रीफ़्रेश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تأكيد التغيير. حدّث المحادثات لعرض أحدث حالة."
          }
        }
      },
      "extractionState": "manual"
    },
