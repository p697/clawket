    "The change could not be confirmed. Reconnect and review this conversation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change could not be confirmed. Reconnect and review this conversation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认更改结果。请重新连接并核对此会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認變更結果。請重新連線並確認此對話。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更結果を確認できませんでした。再接続して、この会話を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 결과를 확인할 수 없습니다. 다시 연결한 후 이 대화를 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderung konnte nicht bestätigt werden. Stelle die Verbindung wieder her und prüfe diese Unterhaltung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification n’a pas pu être confirmée. Reconnectez-vous et vérifiez cette conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido confirmar el cambio. Vuelve a conectarte y revisa esta conversación."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar el cambio. Vuelve a conectarte y revisa esta conversación."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile confermare la modifica. Riconnettiti e controlla questa conversazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar a alteração. Reconecte-se e revise esta conversa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar a alteração. Volte a ligar-se e reveja esta conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить изменение. Подключитесь заново и проверьте этот чат."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося підтвердити зміну. Підключіться знову й перевірте цей чат."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklik doğrulanamadı. Yeniden bağlanıp bu sohbeti gözden geçirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác nhận thay đổi. Hãy kết nối lại rồi kiểm tra cuộc trò chuyện này."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนยันการเปลี่ยนแปลงไม่ได้ โปรดเชื่อมต่อใหม่แล้วตรวจสอบการสนทนานี้"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बदलाव की पुष्टि नहीं हो सकी। फिर से कनेक्ट करके इस बातचीत की समीक्षा करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تأكيد التغيير. أعِد الاتصال وراجع هذه المحادثة."
          }
        }
      },
      "extractionState": "manual"
    },
