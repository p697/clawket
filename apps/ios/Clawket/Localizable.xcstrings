    "Unlock this device and reopen Clawket to access your saved connections.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock this device and reopen Clawket to access your saved connections."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁此设备并重新打开 Clawket，以访问保存的连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解鎖此裝置並重新開啟 Clawket，以存取已儲存的連線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された接続にアクセスするには、デバイスのロックを解除してClawketを開き直してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperre dieses Gerät und öffne Clawket erneut, um auf deine gespeicherten Verbindungen zuzugreifen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez cet appareil et rouvrez Clawket pour accéder à vos connexions enregistrées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca questo dispositivo e riapri Clawket per accedere alle connessioni salvate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea este dispositivo y vuelve a abrir Clawket para acceder a tus conexiones guardadas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea este dispositivo y vuelve a abrir Clawket para acceder a tus conexiones guardadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie este dispositivo e reabra o Clawket para acessar suas conexões salvas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie este dispositivo e volte a abrir o Clawket para aceder às suas ligações guardadas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 연결에 접근하려면 기기의 잠금을 해제한 후 Clawket을 다시 여세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте устройство и снова откройте Clawket для доступа к сохранённым подключениям."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблокуйте пристрій і знову відкрийте Clawket, щоб отримати доступ до збережених підключень."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı bağlantılarınıza erişmek için cihazın kilidini açıp Clawket’i yeniden açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở khóa thiết bị này rồi mở lại Clawket để truy cập các kết nối đã lưu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลดล็อกอุปกรณ์นี้แล้วเปิด Clawket อีกครั้งเพื่อเข้าถึงการเชื่อมต่อที่บันทึกไว้"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेव किए गए कनेक्शन देखने के लिए इस डिवाइस को अनलॉक करके Clawket फिर से खोलें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح قفل هذا الجهاز ثم أعد فتح Clawket للوصول إلى اتصالاتك المحفوظة."
          }
        }
      },
      "comment": "Native UI / accessibility."
    },
