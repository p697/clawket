    "Creation could not be confirmed. Refresh conversations before trying again.": {
      "extractionState": "manual",
      "comment": "Native catalog creation/recovery state. Unknown creation is not permission to replay it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creation could not be confirmed. Refresh conversations before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认是否已创建。请先刷新会话列表，再决定是否重试。"
