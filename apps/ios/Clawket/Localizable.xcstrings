    "Ready when you are. Send this message when the connection is available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready when you are. Send this message when the connection is available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待你确认。连接可用后，你可以发送这条消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待你確認。連線可用後，你可以傳送這則訊息。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認待ちです。接続が利用可能になったら、このメッセージを送信できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet auf deine Bestätigung. Sende diese Nachricht, sobald die Verbindung verfügbar ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de votre confirmation. Envoyez ce message lorsque la connexion sera disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa della tua conferma. Invia questo messaggio quando la connessione sarà disponibile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendiente de tu confirmación. Envía este mensaje cuando la conexión esté disponible."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendiente de tu confirmación. Envía este mensaje cuando la conexión esté disponible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando sua confirmação. Envie esta mensagem quando a conexão estiver disponível."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A aguardar a sua confirmação. Envie esta mensagem quando a ligação estiver disponível."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인을 기다리고 있습니다. 연결이 가능해지면 이 메시지를 보내세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидает вашего подтверждения. Отправьте это сообщение, когда подключение станет доступно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікує на ваше підтвердження. Надішліть це повідомлення, коли підключення стане доступним."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onayınızı bekliyor. Bağlantı kullanılabilir olduğunda bu mesajı gönderin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chờ bạn xác nhận. Gửi tin nhắn này khi có kết nối."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รอการยืนยันจากคุณ ส่งข้อความนี้เมื่อเชื่อมต่อได้"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी पुष्टि का इंतज़ार है। कनेक्शन उपलब्ध होने पर यह संदेश भेजें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بانتظار تأكيدك. أرسل هذه الرسالة عندما يصبح الاتصال متاحًا."
          }
        }
      },
      "comment": "Native UI / accessibility."
    },
    "Reconnect or refresh conversations before creating another.": {
      "extractionState": "manual",
      "comment": "Native catalog creation/recovery state. Unknown creation is not permission to replay it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect or refresh conversations before creating another."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建新会话前，请先重新连接或刷新会话列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立新對話前，請先重新連線或重新整理對話列表。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいチャットを作成する前に、再接続するかチャット一覧を更新してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde dich erneut oder aktualisiere die Chats, bevor du einen weiteren erstellst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez-vous ou actualisez les conversations avant d’en créer une autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconnettiti o aggiorna le conversazioni prima di crearne un’altra."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a conectarte o actualiza las conversaciones antes de crear otra."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a conectarte o actualiza las conversaciones antes de crear otra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconecte ou atualize as conversas antes de criar outra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte a ligar ou atualize as conversas antes de criar outra."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 대화를 생성하기 전에 다시 연결하거나 대화 목록을 새로고침하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь заново или обновите чаты, прежде чем создавать ещё один."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіться знову або оновіть чати, перш ніж створювати ще один."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir sohbet oluşturmadan önce yeniden bağlanın veya sohbetleri yenileyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối lại hoặc làm mới danh sách cuộc trò chuyện trước khi tạo thêm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่ออีกครั้งหรือรีเฟรชการสนทนาก่อนสร้างใหม่"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नई बातचीत बनाने से पहले फिर से कनेक्ट करें या बातचीत रीफ़्रेश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد الاتصال أو حدّث المحادثات قبل إنشاء أخرى."
          }
        }
      }
    },
