            "state": "translated",
            "value": "Tu grabación permanece en este dispositivo hasta que se guarde el texto."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu grabación permanece en este dispositivo hasta que se guarde el texto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
