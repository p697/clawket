    "Use the WebSocket address provided by your agent. Credentials are saved securely on this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the WebSocket address provided by your agent. Credentials are saved securely on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你的 Agent 提供的 WebSocket 地址。凭据将安全保存在此设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你的 Agent 提供的 WebSocket 位址。憑證將安全儲存在此裝置上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが提供するWebSocketアドレスを使用してください。認証情報はこのデバイスに安全に保存されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende die WebSocket-Adresse deines Agenten. Zugangsdaten werden sicher auf diesem Gerät gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez l’adresse WebSocket fournie par votre Agent. Les identifiants sont enregistrés en toute sécurité sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa l’indirizzo WebSocket fornito dal tuo Agent. Le credenziali vengono salvate in modo sicuro su questo dispositivo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la dirección WebSocket que proporciona tu Agente. Las credenciales se guardan de forma segura en este dispositivo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la dirección WebSocket que proporciona tu Agente. Las credenciales se guardan de forma segura en este dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o endereço WebSocket fornecido pelo seu Agent. As credenciais são salvas com segurança neste dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilize o endereço WebSocket fornecido pelo seu Agent. As credenciais são guardadas em segurança neste dispositivo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 제공한 WebSocket 주소를 사용하세요. 자격 증명은 이 기기에 안전하게 저장됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте адрес WebSocket, предоставленный агентом. Учётные данные безопасно сохраняются на этом устройстве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте адресу WebSocket, надану агентом. Облікові дані безпечно зберігаються на цьому пристрої."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent’ınızın sağladığı WebSocket adresini kullanın. Kimlik bilgileri bu cihazda güvenli biçimde saklanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng địa chỉ WebSocket do Agent cung cấp. Thông tin xác thực được lưu an toàn trên thiết bị này."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ที่อยู่ WebSocket ที่ Agent ให้มา ข้อมูลรับรองจะบันทึกอย่างปลอดภัยบนอุปกรณ์นี้"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Agent का दिया हुआ WebSocket पता इस्तेमाल करें। क्रेडेंशियल इस डिवाइस पर सुरक्षित रूप से सेव होते हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم عنوان WebSocket الذي يوفره وكيلك. تُحفظ بيانات الاعتماد بأمان على هذا الجهاز."
          }
        }
      },
      "comment": "Native UI / accessibility."
    },
