    "Your Pro status could not be verified. Try again when you’re online.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Pro status could not be verified. Try again when you’re online."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证你的 Pro 状态。请联网后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證你的 Pro 狀態。請連線後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro の状態を確認できませんでした。オンラインになってからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro 상태를 확인할 수 없습니다. 온라인 상태에서 다시 시도해 주세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Pro-Status konnte nicht bestätigt werden. Versuche es erneut, wenn du online bist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre statut Pro n’a pas pu être vérifié. Réessayez lorsque vous serez en ligne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido verificar tu estado Pro. Vuelve a intentarlo cuando tengas conexión."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar tu estado Pro. Vuelve a intentarlo cuando tengas conexión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile verificare il tuo stato Pro. Riprova quando sei online."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar seu status Pro. Tente novamente quando estiver online."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar o seu estado Pro. Tente novamente quando estiver online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить ваш статус Pro. Повторите попытку, когда появится подключение к интернету."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося перевірити ваш статус Pro. Спробуйте ще раз, коли з’явиться підключення до інтернету."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro durumunuz doğrulanamadı. Çevrimiçi olduğunuzda tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác minh trạng thái Pro của bạn. Hãy thử lại khi có kết nối mạng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถตรวจสอบสถานะ Pro ของคุณได้ โปรดลองอีกครั้งเมื่อออนไลน์"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी Pro स्थिति की पुष्टि नहीं हो सकी। ऑनलाइन होने पर फिर कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من حالة Pro لديك. حاول مجددًا عندما تكون متصلًا بالإنترنت."
          }
        }
      },
      "extractionState": "manual"
    },
    "Your current access is unchanged. Check your store before trying again.": {
      "localizations": {
