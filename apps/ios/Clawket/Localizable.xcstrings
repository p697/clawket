    "History storage is full. Your current conversation has been kept.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History storage is full. Your current conversation has been kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史记录存储空间已满。已保留当前对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歷史記錄儲存空間已滿。目前的對話已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴の保存容量がいっぱいです。現在の会話は保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 저장 공간이 가득 찼습니다. 현재 대화는 보존되었습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicher für den Verlauf ist voll. Dein aktuelles Gespräch wurde beibehalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace de stockage de l’historique est plein. Votre conversation actuelle a été conservée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento del historial está lleno. Tu conversación actual se ha conservado."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento del historial está lleno. Tu conversación actual se conservó."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio per la cronologia è esaurito. La conversazione attuale è stata conservata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento do histórico está cheio. Sua conversa atual foi preservada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento do histórico está cheio. A sua conversa atual foi preservada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранилище истории заполнено. Текущая переписка сохранена."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сховище історії заповнене. Поточну розмову збережено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş depolama alanı dolu. Mevcut konuşmanız korundu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ nhớ lịch sử đã đầy. Cuộc trò chuyện hiện tại của bạn vẫn được giữ lại."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่จัดเก็บประวัติเต็มแล้ว บทสนทนาปัจจุบันของคุณยังคงอยู่"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इतिहास का स्टोरेज भर गया है। आपकी मौजूदा बातचीत सुरक्षित रखी गई है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساحة تخزين السجل ممتلئة. تم الاحتفاظ بمحادثتك الحالية."
          }
        }
      }
    },
