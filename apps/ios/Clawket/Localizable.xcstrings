          }
        }
      }
    },
    "Your recording stays on this device until the text is saved.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recording stays on this device until the text is saved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音会保留在此设备上，直到文字保存完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
