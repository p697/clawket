        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось использовать этот код или ссылку сопряжения. Проверьте их или создайте новое приглашение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося скористатися цим кодом або посиланням з’єднання. Перевірте їх або створіть нове запрошення."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu eşleştirme kodu veya bağlantısı kullanılamadı. Kontrol edin veya yeni bir davet oluşturun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể dùng mã hoặc liên kết ghép nối này. Kiểm tra lại hoặc tạo lời mời mới."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้รหัสหรือลิงก์จับคู่นี้ไม่ได้ ตรวจสอบอีกครั้งหรือสร้างคำเชิญใหม่"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पेयरिंग कोड या लिंक इस्तेमाल नहीं हो सका। इसे जाँचें या नया आमंत्रण बनाएँ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
