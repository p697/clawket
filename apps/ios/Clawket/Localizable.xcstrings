    "Scan the QR code shown by Clawket on your computer, or paste its pairing link.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the QR code shown by Clawket on your computer, or paste its pairing link."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描电脑上 Clawket 显示的二维码，或粘贴配对链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描電腦上 Clawket 顯示的 QR 碼，或貼上配對連結。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータのClawketに表示されたQRコードをスキャンするか、ペアリングリンクを貼り付けてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne den QR-Code, den Clawket auf deinem Computer anzeigt, oder füge den Kopplungslink ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez le code QR affiché par Clawket sur votre ordinateur ou collez son lien de jumelage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona il codice QR mostrato da Clawket sul computer oppure incolla il link di abbinamento."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el código QR que muestra Clawket en tu ordenador o pega su enlace de emparejamiento."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el código QR que muestra Clawket en tu computadora o pega su enlace de emparejamiento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia o código QR mostrado pelo Clawket no computador ou cole o link de pareamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia o código QR apresentado pelo Clawket no computador ou cole a ligação de emparelhamento."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터의 Clawket에 표시된 QR 코드를 스캔하거나 페어링 링크를 붙여넣으세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте QR-код, показанный Clawket на компьютере, или вставьте ссылку сопряжения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відскануйте QR-код, який Clawket показує на комп’ютері, або вставте посилання з’єднання."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarınızdaki Clawket’te gösterilen QR kodunu tarayın veya eşleştirme bağlantısını yapıştırın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét mã QR Clawket hiển thị trên máy tính hoặc dán liên kết ghép nối."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกน QR ที่ Clawket แสดงบนคอมพิวเตอร์ หรือวางลิงก์จับคู่"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्यूटर पर Clawket में दिख रहा QR कोड स्कैन करें या उसका पेयरिंग लिंक पेस्ट करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح رمز QR الذي يعرضه Clawket على الكمبيوتر أو الصق رابط الاقتران."
          }
        }
      },
      "comment": "Native UI / accessibility."
    },
