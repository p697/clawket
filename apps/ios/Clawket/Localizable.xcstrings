        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудио сохранено на этом устройстве. Повторите расшифровку или удалите его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіо збережено на цьому пристрої. Повторіть транскрибування або видаліть його."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiniz bu cihazda saklandı. Yeniden yazıya dönüştürün veya silin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh đã được lưu trên thiết bị này. Hãy thử chuyển thành văn bản lại hoặc xóa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงถูกเก็บไว้ในอุปกรณ์นี้แล้ว คุณสามารถลองถอดเสียงอีกครั้งหรือลบได้"
          }
