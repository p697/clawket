    "Change confirmed. Refresh conversations to see the latest state.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change confirmed. Refresh conversations to see the latest state."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改已确认。刷新会话以查看最新状态。"
