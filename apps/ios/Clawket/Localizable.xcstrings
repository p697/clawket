        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить сохранённую копию. Перед повторной попыткой откройте приложение заново."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося підтвердити збережену копію. Перш ніж повторити спробу, відкрийте застосунок знову."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen kopya doğrulanamadı. Yeniden denemeden önce uygulamayı tekrar açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác nhận bản sao đã lưu. Hãy mở lại ứng dụng trước khi thử lại."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถยืนยันสำเนาที่บันทึกไว้ได้ โปรดเปิดแอปใหม่ก่อนลองอีกครั้ง"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजी गई कॉपी की पुष्टि नहीं हो सकी। दोबारा कोशिश करने से पहले ऐप फिर से खोलें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تأكيد النسخة المحفوظة. أعد فتح التطبيق قبل المحاولة مجددًا."
          }
        }
      }
    },
