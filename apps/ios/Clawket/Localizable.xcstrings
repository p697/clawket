    "This draft could not be saved. Keep Clawket open and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This draft could not be saved. Keep Clawket open and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存这份草稿。请保持 Clawket 打开并重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存這份草稿。請保持 Clawket 開啟並再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下書きを保存できませんでした。Clawketを開いたまま、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Entwurf konnte nicht gespeichert werden. Lass Clawket geöffnet und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce brouillon n’a pas pu être enregistré. Gardez Clawket ouvert et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare questa bozza. Tieni Clawket aperto e riprova."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar este borrador. Mantén Clawket abierto e inténtalo de nuevo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar este borrador. Mantén Clawket abierto e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar este rascunho. Mantenha o Clawket aberto e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar este rascunho. Mantenha o Clawket aberto e tente novamente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초안을 저장하지 못했습니다. Clawket을 열어 둔 상태에서 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить черновик. Не закрывайте Clawket и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
