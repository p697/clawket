          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu taslak kaydedilemedi. Clawket’i açık tutup yeniden deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu bản nháp này. Giữ Clawket mở rồi thử lại."
          }
        },
