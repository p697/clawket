    "After approving the device, check the connection again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After approving the device, check the connection again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准此设备后，请再次检查连接。"
          }
        },
        "zh-Hant": {
