    "Some attachments could not be recovered. Your files have been kept.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some attachments could not be recovered. Your files have been kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分附件无法恢复。你的文件已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分附件無法復原。你的檔案已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の添付ファイルを復元できませんでした。ファイルは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 첨부 파일을 복구하지 못했습니다. 파일은 보관되어 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Anhänge konnten nicht wiederhergestellt werden. Deine Dateien wurden aufbewahrt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines pièces jointes n’ont pas pu être récupérées. Vos fichiers ont été conservés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido recuperar algunos archivos adjuntos. Tus archivos se han conservado."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron recuperar algunos archivos adjuntos. Tus archivos se conservaron."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile recuperare alcuni allegati. I tuoi file sono stati conservati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível recuperar alguns anexos. Seus arquivos foram mantidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível recuperar alguns anexos. Os seus ficheiros foram mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось восстановить некоторые вложения. Ваши файлы сохранены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відновити деякі вкладення. Ваші файли збережено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı ekler kurtarılamadı. Dosyalarınız korundu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể khôi phục một số tệp đính kèm. Các tệp của bạn đã được giữ lại."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กู้คืนไฟล์แนบบางรายการไม่สำเร็จ ระบบยังเก็บไฟล์ของคุณไว้"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ अटैचमेंट बहाल नहीं हो सके। आपकी फ़ाइलें सुरक्षित रखी गई हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت استعادة بعض المرفقات. تم الاحتفاظ بملفاتك."
          }
        }
      }
    },
