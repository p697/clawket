    "Model authentication failed. Sign in again on your computer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model authentication failed. Sign in again on your computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型认证失败，请在电脑上重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型驗證失敗，請在電腦上重新登入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルの認証に失敗しました。パソコンで再ログインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 인증에 실패했습니다. 컴퓨터에서 다시 로그인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellanmeldung fehlgeschlagen. Melde dich am Computer erneut an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’authentification du modèle a échoué. Reconnectez-vous sur votre ordinateur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló la autenticación del modelo. Inicia sesión de nuevo en tu ordenador."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló la autenticación del modelo. Inicia sesión de nuevo en tu computadora."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Autenticazione del modello non riuscita. Accedi di nuovo sul tuo computer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na autenticação do modelo. Entre novamente no seu computador."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na autenticação do modelo. Inicie sessão novamente no seu computador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка аутентификации модели. Войдите заново на компьютере."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Помилка автентифікації моделі. Увійдіть знову на комп’ютері."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model kimlik doğrulaması başarısız. Bilgisayarınızda yeniden giriş yapın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác thực mô hình thất bại. Hãy đăng nhập lại trên máy tính."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การยืนยันตัวตนของโมเดลล้มเหลว โปรดลงชื่อเข้าใช้อีกครั้งบนคอมพิวเตอร์"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल प्रमाणीकरण विफल। अपने कंप्यूटर पर फिर से साइन इन करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشلت مصادقة النموذج. سجّل الدخول مجددًا على جهاز الكمبيوتر."
          }
        }
      },
      "comment": "Fixed system notice. Terminology reused from Mobile chat.Model authentication failed. Sign in again on your computer."
    },
