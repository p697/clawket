    "You can paste the QR text or enter the pairing code instead. Check camera access in Settings if needed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can paste the QR text or enter the pairing code instead. Check camera access in Settings if needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以粘贴二维码内容或输入配对码。需要时，请在系统设置中检查相机权限。"
