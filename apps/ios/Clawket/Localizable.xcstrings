    "This connection is not encrypted. Use a trusted network or switch to Relay.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This connection is not encrypted. Use a trusted network or switch to Relay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此连接未加密，请在可信网络使用，或改用中继连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此連線未加密，請在可信網路使用，或改用中繼連線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この接続は暗号化されていません。信頼できるネットワークを使うか、中継接続に切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 연결은 암호화되지 않았습니다. 신뢰할 수 있는 네트워크를 사용하거나 릴레이 연결로 전환하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Verbindung ist unverschlüsselt. Nutze ein vertrauenswürdiges Netzwerk oder eine Relay-Verbindung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette connexion n’est pas chiffrée. Utilisez un réseau de confiance ou une connexion relais."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conexión no está cifrada. Usa una red de confianza o cambia a una conexión de retransmisión."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conexión no está cifrada. Usa una red de confianza o cambia a una conexión de retransmisión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa connessione non è crittografata. Usa una rete fidata o passa a una connessione relay."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conexão não é criptografada. Use uma rede confiável ou mude para uma conexão de retransmissão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ligação não está encriptada. Use uma rede de confiança ou mude para uma ligação de retransmissão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это соединение не зашифровано. Используйте доверенную сеть или подключение через ретранслятор."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
