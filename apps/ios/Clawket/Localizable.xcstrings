    "Preferences are unavailable. Reopen Clawket before trying again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferences are unavailable. Reopen Clawket before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "偏好设置不可用。请重新打开 Clawket 后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偏好設定無法使用。請重新開啟 Clawket 後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境設定を利用できません。Clawketを開き直してから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환경설정을 사용할 수 없습니다. Clawket을 다시 연 후 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungen sind nicht verfügbar. Öffne Clawket erneut, bevor du es noch einmal versuchst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les préférences sont indisponibles. Rouvrez Clawket avant de réessayer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las preferencias no están disponibles. Vuelve a abrir Clawket antes de intentarlo de nuevo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las preferencias no están disponibles. Vuelve a abrir Clawket antes de intentarlo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le preferenze non sono disponibili. Riapri Clawket prima di riprovare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As preferências estão indisponíveis. Reabra o Clawket antes de tentar novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As preferências não estão disponíveis. Volte a abrir o Clawket antes de tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки недоступны. Перед повторной попыткой откройте Clawket заново."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування недоступні. Перш ніж повторити спробу, відкрийте Clawket знову."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tercihler kullanılamıyor. Yeniden denemeden önce Clawket’i tekrar açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể truy cập tùy chọn. Hãy mở lại Clawket trước khi thử lại."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถใช้ค่ากำหนดได้ โปรดเปิด Clawket ใหม่ก่อนลองอีกครั้ง"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्राथमिकताएँ उपलब्ध नहीं हैं। दोबारा कोशिश करने से पहले Clawket फिर से खोलें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التفضيلات غير متاحة. أعد فتح Clawket قبل المحاولة مجددًا."
          }
        }
      },
      "comment": "Native free appearance/settings. "
    },
