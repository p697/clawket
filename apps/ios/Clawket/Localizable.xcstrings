      "comment": "Native catalog creation/recovery state. Unknown creation is not permission to replay it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversations could not be refreshed. Check your connection and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法刷新会话。请检查连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法重新整理對話。請檢查連線後再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットを更新できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats konnten nicht aktualisiert werden. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conversations n’ont pas pu être actualisées. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aggiornare le conversazioni. Controlla la connessione e riprova."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido actualizar las conversaciones. Comprueba la conexión e inténtalo de nuevo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron actualizar las conversaciones. Revisa la conexión e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível atualizar as conversas. Verifique sua conexão e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível atualizar as conversas. Verifique a sua ligação e tente novamente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화를 새로고침하지 못했습니다. 연결을 확인한 후 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обновить чаты. Проверьте подключение и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося оновити чати. Перевірте підключення й спробуйте ще раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbetler yenilenemedi. Bağlantınızı kontrol edip yeniden deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể làm mới cuộc trò chuyện. Kiểm tra kết nối rồi thử lại."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีเฟรชการสนทนาไม่สำเร็จ ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बातचीत रीफ़्रेश नहीं हो सकीं। कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحديث المحادثات. تحقّق من الاتصال وحاول مرة أخرى."
          }
        }
      }
    },
