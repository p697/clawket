          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez le code QR affiché par Clawket sur votre ordinateur ou collez son lien de jumelage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona il codice QR mostrato da Clawket sul computer oppure incolla il link di abbinamento."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el código QR que muestra Clawket en tu ordenador o pega su enlace de emparejamiento."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el código QR que muestra Clawket en tu computadora o pega su enlace de emparejamiento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
