    "Your data could not be saved safely. Keep Clawket open and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data could not be saved safely. Keep Clawket open and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全保存数据。请保持 Clawket 打开并重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法安全儲存資料。請保持 Clawket 開啟並再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データを安全に保存できませんでした。Clawketを開いたまま、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten konnten nicht sicher gespeichert werden. Lass Clawket geöffnet und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données n’ont pas pu être enregistrées en toute sécurité. Gardez Clawket ouvert et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare i dati in sicurezza. Tieni Clawket aperto e riprova."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido guardar tus datos de forma segura. Mantén Clawket abierto e inténtalo de nuevo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar tus datos de forma segura. Mantén Clawket abierto e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar seus dados com segurança. Mantenha o Clawket aberto e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar os seus dados em segurança. Mantenha o Clawket aberto e tente novamente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터를 안전하게 저장하지 못했습니다. Clawket을 열어 둔 상태에서 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось безопасно сохранить данные. Не закрывайте Clawket и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося безпечно зберегти дані. Не закривайте Clawket і спробуйте ще раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verileriniz güvenli biçimde kaydedilemedi. Clawket’i açık tutup yeniden deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu dữ liệu một cách an toàn. Giữ Clawket mở rồi thử lại."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกข้อมูลอย่างปลอดภัยไม่สำเร็จ เปิด Clawket ค้างไว้แล้วลองอีกครั้ง"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका डेटा सुरक्षित ढंग से सेव नहीं हो सका। Clawket खुला रखें और फिर से कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ بياناتك بأمان. أبقِ Clawket مفتوحًا وحاول مرة أخرى."
          }
        }
      },
      "comment": "Native UI / accessibility."
    },
