    "Creation could not be confirmed. Refresh conversations before trying again.": {
      "extractionState": "manual",
      "comment": "Native catalog creation/recovery state. Unknown creation is not permission to replay it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creation could not be confirmed. Refresh conversations before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认是否已创建。请先刷新会话列表，再决定是否重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認是否已建立。請先重新整理對話列表，再決定是否重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成を確認できませんでした。再試行する前にチャット一覧を更新してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erstellung konnte nicht bestätigt werden. Aktualisiere die Chats, bevor du es erneut versuchst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La création n’a pas pu être confirmée. Actualisez les conversations avant de réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile confermare la creazione. Aggiorna le conversazioni prima di riprovare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido confirmar la creación. Actualiza las conversaciones antes de volver a intentarlo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar la creación. Actualiza las conversaciones antes de volver a intentarlo."
          }
        },
        "pt-BR": {
