    "Camera access is unavailable. Check Settings or choose a photo.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is unavailable. Check Settings or choose a photo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
