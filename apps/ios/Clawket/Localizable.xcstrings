          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modification confirmée. Actualisez les conversations pour voir leur état actuel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambio confirmado. Actualiza las conversaciones para ver su estado más reciente."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambio confirmado. Actualiza las conversaciones para ver su estado más reciente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica confermata. Aggiorna le conversazioni per vedere lo stato più recente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alteração confirmada. Atualize as conversas para ver o estado mais recente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alteração confirmada. Atualize as conversas para ver o estado mais recente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение подтверждено. Обновите список чатов, чтобы увидеть текущее состояние."
          }
        },
        "uk": {
          "stringUnit": {
