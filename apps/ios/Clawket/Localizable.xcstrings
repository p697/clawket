    "Microphone access is required to transcribe speech.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access is required to transcribe speech."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要麦克风权限才能转录语音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
