    "Pairing data could not be saved. Try Connect again to save the existing result.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing data could not be saved. Try Connect again to save the existing result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存配对数据。请再次点按“连接”，保存已有的配对结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存配對資料。請再次點一下「連線」，儲存已有的配對結果。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング情報を保存できませんでした。「接続」をもう一度押して、取得済みの結果を保存してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopplungsdaten konnten nicht gespeichert werden. Tippe erneut auf „Verbinden“, um das vorhandene Ergebnis zu speichern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de jumelage n’ont pas pu être enregistrées. Touchez à nouveau « Connecter » pour enregistrer le résultat existant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare i dati di abbinamento. Tocca di nuovo “Connetti” per salvare il risultato già ottenuto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido guardar los datos de emparejamiento. Toca «Conectar» de nuevo para guardar el resultado existente."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar los datos de emparejamiento. Toca «Conectar» de nuevo para guardar el resultado existente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar os dados de pareamento. Toque em “Conectar” novamente para salvar o resultado já obtido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar os dados de emparelhamento. Toque novamente em «Ligar» para guardar o resultado já obtido."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링 데이터를 저장하지 못했습니다. 기존 결과를 저장하려면 '연결'을 다시 누르세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить данные сопряжения. Нажмите «Подключить» ещё раз, чтобы сохранить уже полученный результат."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти дані з’єднання. Знову натисніть «Підключити», щоб зберегти вже отриманий результат."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleştirme verileri kaydedilemedi. Mevcut sonucu kaydetmek için yeniden Bağlan’a dokunun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu dữ liệu ghép nối. Nhấn Kết nối lần nữa để lưu kết quả đã có."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกข้อมูลการจับคู่ไม่สำเร็จ แตะเชื่อมต่ออีกครั้งเพื่อบันทึกผลลัพธ์ที่มีอยู่"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेयरिंग का डेटा सेव नहीं हो सका। मौजूदा नतीजा सेव करने के लिए फिर से “कनेक्ट करें” पर टैप करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ بيانات الاقتران. اضغط «اتصال» مجددًا لحفظ النتيجة الموجودة."
          }
        }
      },
      "comment": "Native UI / accessibility."
    },
