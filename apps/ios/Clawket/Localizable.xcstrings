        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à câmera está indisponível. Verifique os Ajustes ou escolha uma foto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à câmara está indisponível. Verifique as Definições ou escolha uma fotografia."
