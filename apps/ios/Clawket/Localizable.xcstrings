        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已確認變更。請重新整理對話以查看最新狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を確認しました。会話を更新して最新の状態を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경이 확인되었습니다. 대화 목록을 새로 고쳐 최신 상태를 확인하세요."
          }
        },
        "de": {
