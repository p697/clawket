    "Reset this conversation on the connected agent? Your local draft and pending messages will be kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset this conversation on the connected agent? Your local draft and pending messages will be kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要重置已连接 Agent 上的此会话吗？本地草稿和待发送消息将会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要重設已連線 Agent 上的此對話嗎？本機草稿和待傳送訊息將會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続中のエージェントでこの会話をリセットしますか？端末内の下書きと送信待ちのメッセージは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 에이전트에서 이 대화를 초기화할까요? 기기의 초안과 대기 중인 메시지는 유지됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Unterhaltung beim verbundenen Agenten zurücksetzen? Dein lokaler Entwurf und deine ausstehenden Nachrichten bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialiser cette conversation sur l’agent connecté ? Votre brouillon local et vos messages en attente seront conservés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Restablecer esta conversación en el agente conectado? Se conservarán el borrador local y los mensajes pendientes."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Restablecer esta conversación en el agente conectado? Se conservarán el borrador local y los mensajes pendientes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Reimpostare questa conversazione sull’agente connesso? La bozza locale e i messaggi in attesa verranno conservati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redefinir esta conversa no agente conectado? Seu rascunho local e suas mensagens pendentes serão mantidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Repor esta conversa no agente ligado? O rascunho local e as mensagens pendentes serão mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбросить этот чат у подключённого агента? Локальный черновик и ожидающие отправки сообщения будут сохранены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скинути цей чат у підключеного агента? Локальну чернетку та повідомлення, що очікують на надсилання, буде збережено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sohbet bağlı ajanda sıfırlansın mı? Yerel taslağınız ve bekleyen mesajlarınız korunacak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt lại cuộc trò chuyện này trên Agent đang kết nối? Bản nháp và tin nhắn đang chờ trên thiết bị sẽ được giữ lại."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีเซ็ตการสนทนานี้บน Agent ที่เชื่อมต่ออยู่หรือไม่ ฉบับร่างและข้อความที่รอส่งบนอุปกรณ์นี้จะยังคงอยู่"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या कनेक्ट किए गए एजेंट पर यह बातचीत रीसेट करनी है? इस डिवाइस के ड्राफ़्ट और लंबित संदेश सुरक्षित रहेंगे।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إعادة تعيين هذه المحادثة على الوكيل المتصل؟ ستبقى مسودتك المحلية ورسائلك المعلّقة محفوظة."
          }
        }
      },
      "extractionState": "manual"
    },
