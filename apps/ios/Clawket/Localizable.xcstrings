    "Microphone access is required to transcribe speech.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access is required to transcribe speech."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要麦克风权限才能转录语音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要麥克風權限才能轉錄語音。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声を文字起こしするにはマイクへのアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성을 텍스트로 변환하려면 마이크 접근 권한이 필요합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Spracherkennung ist Mikrofonzugriff erforderlich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au micro est nécessaire pour transcrire la parole."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita acceso al micrófono para transcribir la voz."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita acceso al micrófono para transcribir la voz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per trascrivere la voce è necessario l’accesso al microfono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessário acesso ao microfone para transcrever a fala."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessário acesso ao microfone para transcrever a fala."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для расшифровки речи нужен доступ к микрофону."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для розшифрування мовлення потрібен доступ до мікрофона."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşmayı yazıya dökmek için mikrofon erişimi gerekiyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần quyền truy cập micrô để chuyển giọng nói thành văn bản."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องได้รับสิทธิ์เข้าถึงไมโครโฟนเพื่อถอดเสียงพูด"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बोली को टेक्स्ट में बदलने के लिए माइक्रोफ़ोन एक्सेस ज़रूरी है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم الوصول إلى الميكروفون لتحويل الكلام إلى نص."
          }
        }
      }
    },
