    "Cannot save more audio. Free up device storage or remove a saved recording.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot save more audio. Free up device storage or remove a saved recording."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存更多音频，请释放设备空间或删除已保存的录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存更多音訊，請釋放裝置空間或刪除已儲存的錄音。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声を保存できません。端末の空き容量を増やすか、保存済みの録音を削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오를 더 저장할 수 없습니다. 기기 공간을 확보하거나 저장된 녹음을 삭제하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es kann kein weiteres Audio gespeichert werden. Schaffe Speicherplatz oder lösche eine gespeicherte Aufnahme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de sauvegarder davantage d’audio. Libérez de l’espace ou supprimez un enregistrement sauvegardé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede guardar más audio. Libera espacio o elimina una grabación guardada."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede guardar más audio. Libera espacio o elimina una grabación guardada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare altro audio. Libera spazio o elimina una registrazione salvata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível salvar mais áudio. Libere espaço ou exclua uma gravação salva."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível guardar mais áudio. Liberte espaço ou elimine uma gravação guardada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невозможно сохранить больше аудио. Освободите место или удалите сохранённую запись."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неможливо зберегти більше аудіо. Звільніть місце або видаліть збережений запис."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha fazla ses kaydedilemiyor. Yer açın veya saklanan bir kaydı silin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu thêm âm thanh. Hãy giải phóng dung lượng hoặc xóa bản ghi đã lưu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถบันทึกเสียงเพิ่มได้ โปรดเพิ่มพื้นที่ว่างหรือลบบันทึกเสียงที่เก็บไว้"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "और ऑडियो नहीं सहेज सकते। डिवाइस में जगह खाली करें या सहेजी गई रिकॉर्डिंग हटाएँ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن حفظ المزيد من الصوت. أفرغ مساحة على الجهاز أو احذف تسجيلاً محفوظاً."
          }
        }
      }
    },
