    "Tap to record. Hold and release to send. Slide up to cancel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to record. Hold and release to send. Slide up to cancel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点开始录音。按住后松开发送，上滑取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下開始錄音。按住後放開傳送，向上滑動取消。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップで録音を開始します。長押しして離すと送信、上にスライドするとキャンセルします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Aufnehmen tippen. Zum Senden gedrückt halten und loslassen. Zum Abbrechen nach oben schieben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour enregistrer. Maintenez puis relâchez pour envoyer. Glissez vers le haut pour annuler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per registrare. Tieni premuto e rilascia per inviare. Scorri verso l’alto per annullare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para grabar. Mantén pulsado y suelta para enviar. Desliza hacia arriba para cancelar."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para grabar. Mantén presionado y suelta para enviar. Desliza hacia arriba para cancelar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para gravar. Mantenha pressionado e solte para enviar. Deslize para cima para cancelar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para gravar. Mantenha premido e solte para enviar. Deslize para cima para cancelar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하여 녹음을 시작하세요. 길게 누른 뒤 놓으면 전송되고 위로 밀면 취소됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите для записи. Удерживайте и отпустите для отправки. Сдвиньте вверх для отмены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть для запису. Утримуйте й відпустіть для надсилання. Посуньте вгору для скасування."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydetmek için dokunun. Göndermek için basılı tutup bırakın. İptal etmek için yukarı kaydırın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm để ghi âm. Nhấn giữ rồi thả để gửi. Vuốt lên để hủy."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเพื่อบันทึกเสียง กดค้างแล้วปล่อยเพื่อส่ง ปัดขึ้นเพื่อยกเลิก"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड करने के लिए टैप करें। दबाकर रखें और भेजने के लिए छोड़ दें। रद्द करने के लिए ऊपर स्लाइड करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط لبدء التسجيل. اضغط مطولًا ثم أفلت للإرسال. اسحب لأعلى للإلغاء."
          }
        }
      },
      "comment": "Native UI / accessibility."
    },
    "The confirmation expired. Review this request again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية التأكيد. راجع هذا الطلب مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bestätigung ist abgelaufen. Prüfe diese Anfrage erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The confirmation expired. Review this request again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La confirmación ha caducado. Revisa esta solicitud de nuevo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La confirmación venció. Revisa esta solicitud de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La confirmation a expiré. Examinez à nouveau cette demande."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुष्टि की समय-सीमा समाप्त हो गई। इस अनुरोध की फिर से समीक्षा करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La conferma è scaduta. Esamina di nuovo questa richiesta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認の有効期限が切れました。このリクエストをもう一度確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 유효 시간이 만료되었습니다. 이 요청을 다시 검토하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A confirmação expirou. Revise esta solicitação novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A confirmação expirou. Reveja este pedido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок подтверждения истёк. Проверьте этот запрос ещё раз."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การยืนยันหมดอายุแล้ว โปรดตรวจสอบคำขอนี้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onayın süresi doldu. Bu isteği yeniden inceleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термін підтвердження минув. Перегляньте цей запит ще раз."
          }
        },
        "vi": {
          "stringUnit": {
