    "No new Pro access confirmed yet. If you redeemed a code, tap Restore.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تأكيد وصول جديد إلى Pro بعد. إذا استرددت رمزًا، فانقر على استعادة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein neuer Pro-Zugang bestätigt. Tippe nach dem Einlösen auf Wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No new Pro access confirmed yet. If you redeemed a code, tap Restore."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se ha confirmado un nuevo acceso Pro. Si canjeaste un código, pulsa Restaurar."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se ha confirmado un nuevo acceso Pro. Si canjeaste un código, toca Restaurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun nouvel accès Pro confirmé. Si vous avez utilisé un code, touchez Restaurer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नए Pro ऐक्सेस की अभी पुष्टि नहीं हुई है। कोड रिडीम किया है तो बहाल करें पर टैप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun nuovo accesso Pro confermato. Se hai riscattato un codice, tocca Ripristina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい Pro の利用権はまだ確認できません。利用済みの場合は「復元」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 Pro 이용 권한이 아직 확인되지 않았습니다. 코드를 사용했다면 복원을 누르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum novo acesso Pro confirmado. Se resgatou um código, toque em Restaurar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não foi confirmado um novo acesso Pro. Se resgataste um código, toca em Restaurar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый доступ Pro пока не подтверждён. Если вы активировали код, нажмите «Восстановить»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ยืนยันสิทธิ์ Pro ใหม่ หากแลกรหัสแล้ว ให้แตะกู้คืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni Pro erişimi henüz doğrulanmadı. Kod kullandıysan Geri yükle’ye dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Новий доступ Pro ще не підтверджено. Якщо ви активували код, натисніть «Відновити»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa xác nhận quyền truy cập Pro mới. Nếu đã đổi mã, hãy nhấn Khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂未确认新的 Pro 权益。如已兑换，请点“恢复”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫未確認新的 Pro 權益。如已兌換，請點「恢復」。"
          }
        }
      },
      "extractionState": "manual"
    },
