{
  "name": "@clawket/registry-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@clawket/shared": "0.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260220.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:hermes": "node ../../scripts/relay/run-wrangler.mjs dev relay-registry --config-file wrangler.hermes.local.toml",
    "deploy": "node ../../scripts/relay/run-wrangler.mjs deploy relay-registry",
    "deploy:hermes": "node ../../scripts/relay/run-wrangler.mjs deploy relay-registry --config-file wrangler.hermes.local.toml",
    "tail:hermes": "node ../../scripts/relay/run-wrangler.mjs tail relay-registry --config-file wrangler.hermes.local.toml",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "echo \"No lint for registry worker\""
  }
}
