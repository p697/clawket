{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "clawket-speech-self-hosted",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "vars": {
    "ALIYUN_SPEECH_URL": "https://speech-provider.example.com/api-ws/v1/inference",
    "SPEECH_ENABLED": "false"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ADMISSION",
        "class_name": "SpeechAdmission"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SpeechAdmission"
      ]
    }
  ]
}
