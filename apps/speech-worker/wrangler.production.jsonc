{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "clawket-speech-self-hosted-production",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_request_signal"
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "speech.example.com",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": [
      "ALIYUN_SPEECH_API_KEY"
    ]
  },
  "observability": {
    "redact_query_string": true,
    "traces": { "enabled": false },
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "vars": {
    "ALIYUN_SPEECH_URL": "https://speech-provider.example.com/api-ws/v1/inference",
    "SPEECH_ENABLED": "false"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ADMISSION",
        "class_name": "SpeechAdmission"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SpeechAdmission"
      ]
    }
  ]
}
