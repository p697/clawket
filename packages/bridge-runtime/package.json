{
  "name": "@clawket/bridge-runtime",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-typescript.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --no-file-parallelism",
    "test:required": "vitest run src --exclude '**/*.integration.test.ts'",
    "test:hermes-integration": "vitest run src/hermes/*.integration.test.ts --no-file-parallelism",
    "test:codex-desktop-integration": "vitest run src/codex/desktop.integration.test.ts --config vitest.native.config.ts --maxWorkers=2",
    "test:claude-desktop-integration": "vitest run src/claude-code/desktop.integration.test.ts --config vitest.native.config.ts --maxWorkers=2",
    "test:codex-activity-integration": "vitest run src/codex/session-activity.integration.test.ts --config vitest.native.config.ts --maxWorkers=2",
    "test:codex-profile-integration": "vitest run src/codex/profile.integration.test.ts --config vitest.native.config.ts --maxWorkers=2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "@clawket/agent-protocol": "3.0.0",
    "@clawket/bridge-core": "3.1.0",
    "https-proxy-agent": "^7.0.6",
    "tweetnacl": "^1.0.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
